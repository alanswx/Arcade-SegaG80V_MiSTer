<misterromdescription>
    <about author="alanswx" webpage="https://github.com/alanswx/Arcade-SegaG80V_MiSTer"/>
    <name>Tac/Scan</name>
    <setname>tacscan</setname>
    <rbf>Arcade-SegaG80V</rbf>
    <mameversion>0283</mameversion>
    <year>1982</year>
    <manufacturer>Sega</manufacturer>
    <category>Shooter</category>
    <!-- index 0: 48K program ROM at $0000, sin/cos PROM at $C000 -->
    <rom index="0" zip="tacscan.zip" md5="none">
        <part name="1711a.cpu-u25" crc="0da13158"/>
        <part name="1670c.prom-u1" crc="98de6fd5"/>
        <part name="1671a.prom-u2" crc="dc400074"/>
        <part name="1672a.prom-u3" crc="2caf6f7e"/>
        <part name="1673a.prom-u4" crc="1495ce3d"/>
        <part name="1674a.prom-u5" crc="ab7fc5d9"/>
        <part name="1675a.prom-u6" crc="cf5e5016"/>
        <part name="1676a.prom-u7" crc="b61a3ab3"/>
        <part name="1677a.prom-u8" crc="bc0273b1"/>
        <part name="1678b.prom-u9" crc="7894da98"/>
        <part name="1679a.prom-u10" crc="db865654"/>
        <part name="1680a.prom-u11" crc="2c2454de"/>
        <part name="1681a.prom-u12" crc="77028885"/>
        <part name="1682a.prom-u13" crc="babe5cf1"/>
        <part name="1683a.prom-u14" crc="1b98b618"/>
        <part name="1684a.prom-u15" crc="cb3ded3b"/>
        <part name="1685a.prom-u16" crc="43016a79"/>
        <part name="1686a.prom-u17" crc="a4397772"/>
        <part name="1687a.prom-u18" crc="002f3bc4"/>
        <part name="1688a.prom-u19" crc="0326d87a"/>
        <part name="1709a.prom-u20" crc="f35ed1ec"/>
        <part name="1710a.prom-u21" crc="6203be22"/>
        <part repeat="4096">00</part>
        <!-- $C000: sin/cos PROM, X-Y Timing board U39 -->
        <part name="s-c.xyt-u39" crc="56484d19"/>
    </rom>

    <!-- index 1: game identifier, decoded by rtl/sega_game_pkg.sv -->
    <rom index="1">
        <part>04</part>
    </rom>

    <!-- index 254: DIP switches. byte 0 = SW1 (read at $F8-$FB bits 3:2),
         byte 1 = SW2 (coinage, bits 1:0). Both are active low. -->
    <rom index="254" zip="" type="nonmerged" md5="none">
        <part>FF 33</part>
    </rom>

    <buttons names="Fire,Thrust,Start 1,Start 2,Coin,Pause" default="A,B,Start,Select,R,L"/>
</misterromdescription>
