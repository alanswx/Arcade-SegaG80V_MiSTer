<misterromdescription>
    <about author="alanswx" webpage="https://github.com/alanswx/Arcade-SegaG80V_MiSTer"/>
    <name>Eliminator (4 Players, prototype)</name>
    <setname>elim4p</setname>
    <rbf>Arcade-SegaG80V</rbf>
    <mameversion>0283</mameversion>
    <year>1981</year>
    <manufacturer>Gremlin</manufacturer>
    <category>Shooter</category>
    <parent>elim2</parent>
    <!-- index 0: 48K program ROM at $0000, sin/cos PROM at $C000 -->
    <rom index="0" zip="elim4p.zip|elim2.zip" md5="none">
        <part name="1390.cpu-u25" crc="97010c3e"/>
        <part name="sw1.prom-u1" crc="5350b8eb"/>
        <part name="sw2.prom-u2" crc="44f45465"/>
        <part name="sw3.prom-u3" crc="5b692c3c"/>
        <part name="sw4.prom-u4" crc="0b78dd00"/>
        <part name="sw5.prom-u5" crc="8b3795f1"/>
        <part name="sw6.prom-u6" crc="4304b503"/>
        <part name="sw7.prom-u7" crc="3cb4a604"/>
        <part name="sw8.prom-u8" crc="bdc55223"/>
        <part name="sw9.prom-u9" crc="f6ca1bf1"/>
        <part name="swa.prom-u10" crc="12373f7f"/>
        <part name="swb.prom-u11" crc="d1effc6b"/>
        <part name="swc.prom-u12" crc="bf361ab3"/>
        <part name="swd.prom-u13" crc="ae2c88e5"/>
        <part name="swe.prom-u14" crc="ec4cc343"/>
        <part repeat="18432">00</part>
        <!-- $C000: sin/cos PROM, X-Y Timing board U39 -->
        <part name="s-c.xyt-u39" crc="56484d19"/>
        <part repeat="2048">00</part>
        <part repeat="16384">00</part>
    </rom>

    <!-- index 1: game identifier, decoded by rtl/sega_game_pkg.sv -->
    <rom index="1">
        <part>01</part>
    </rom>

    <!-- index 254: DIP switches. byte 0 = SW1 (read at $F8-$FB bits 3:2),
         byte 1 = SW2 (coinage, bits 1:0). Both are active low. -->
    <rom index="254" zip="" type="nonmerged" md5="none">
        <part>FF 33</part>
    </rom>

    <buttons names="Fire,Thrust,Start 1,Start 2,Coin,Pause" default="A,B,Start,Select,R,L"/>
</misterromdescription>
