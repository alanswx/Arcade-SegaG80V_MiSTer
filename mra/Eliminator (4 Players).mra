<misterromdescription>
    <about author="alanswx" webpage="https://github.com/alanswx/Arcade-SegaG80V_MiSTer"/>
    <name>Eliminator (4 Players)</name>
    <setname>elim4</setname>
    <rbf>Arcade-SegaG80V</rbf>
    <mameversion>0283</mameversion>
    <year>1981</year>
    <manufacturer>Gremlin</manufacturer>
    <category>Shooter</category>
    <parent>elim2</parent>
    <!-- index 0: 48K program ROM at $0000, sin/cos PROM at $C000 -->
    <rom index="0" zip="elim4.zip|elim2.zip" md5="none">
        <part name="1390.cpu-u25" crc="97010c3e"/>
        <part name="1347.prom-u1" crc="657d7320"/>
        <part name="1348.prom-u2" crc="b15fe578"/>
        <part name="1349.prom-u3" crc="0702b586"/>
        <part name="1350.prom-u4" crc="4168dd3b"/>
        <part name="1351.prom-u5" crc="c950f24c"/>
        <part name="1352.prom-u6" crc="dc8c91cc"/>
        <part name="1353.prom-u7" crc="11eda631"/>
        <part name="1354.prom-u8" crc="b9dd6e7a"/>
        <part name="1355.prom-u9" crc="c92c7237"/>
        <part name="1356.prom-u10" crc="889b98e3"/>
        <part name="1357.prom-u11" crc="d79248a5"/>
        <part name="1358.prom-u12" crc="c5dabc77"/>
        <part name="1359.prom-u13" crc="24c8e5d8"/>
        <part name="1360.prom-u14" crc="96d48238"/>
        <part repeat="18432">00</part>
        <!-- $C000: sin/cos PROM, X-Y Timing board U39 -->
        <part name="s-c.xyt-u39" crc="56484d19"/>
        <part repeat="2048">00</part>
        <part repeat="16384">00</part>
    </rom>

    <!-- index 1: game identifier, decoded by rtl/sega_game_pkg.sv -->
    <rom index="1">
        <part>01</part>
    </rom>

    <!-- index 254: DIP switches. byte 0 = SW1 (read at $F8-$FB bits 3:2),
         byte 1 = SW2 (coinage, bits 1:0). Both are active low. -->
    <rom index="254" zip="" type="nonmerged" md5="none">
        <part>FF 33</part>
    </rom>

    <buttons names="Fire,Thrust,Start 1,Start 2,Coin,Pause" default="A,B,Start,Select,R,L"/>
</misterromdescription>
